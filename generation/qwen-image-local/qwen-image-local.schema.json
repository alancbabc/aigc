{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Qwen Image Local Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "skill",
    "request",
    "response_handling",
    "artifacts"
  ],
  "properties": {
    "skill": {
      "const": "qwen-image-local"
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prompt",
        "mode",
        "output_path"
      ],
      "properties": {
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "type": "string",
          "enum": [
            "text_to_image",
            "image_edit"
          ]
        },
        "negative_prompt": {
          "type": "string"
        },
        "seed": {
          "type": "integer"
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "num_inference_steps": {
          "type": "integer",
          "minimum": 1
        },
        "images": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "base_url": {
          "type": "string",
          "minLength": 1
        },
        "output_path": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "image_edit"
              }
            }
          },
          "then": {
            "required": [
              "images"
            ],
            "properties": {
              "images": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "response_handling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transport",
        "submit_endpoint",
        "status_endpoint",
        "download_endpoint",
        "poll_until"
      ],
      "properties": {
        "transport": {
          "type": "string",
          "const": "binary_download"
        },
        "submit_endpoint": {
          "type": "string",
          "const": "/submit"
        },
        "status_endpoint": {
          "type": "string",
          "const": "/status/{task_id}"
        },
        "download_endpoint": {
          "type": "string",
          "const": "/download/{task_id}"
        },
        "poll_until": {
          "type": "string",
          "const": "done"
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "mime_type",
          "role"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "mime_type": {
            "type": "string",
            "enum": [
              "image/png",
              "image/jpeg"
            ]
          },
          "role": {
            "type": "string",
            "enum": [
              "primary"
            ]
          }
        }
      }
    }
  }
}
