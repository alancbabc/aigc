{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Qwen-Image-2512 Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "skill",
    "request",
    "response_handling",
    "artifacts"
  ],
  "properties": {
    "skill": {
      "const": "qwen-image-2512"
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prompt",
        "model",
        "size",
        "language_mode"
      ],
      "properties": {
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "const": "Qwen-Image-2512"
        },
        "size": {
          "type": "string",
          "pattern": "^[0-9]+x[0-9]+$"
        },
        "language_mode": {
          "type": "string",
          "enum": [
            "workflow_english",
            "standalone_chinese_experiment"
          ]
        },
        "num_inference_steps": {
          "type": "integer",
          "minimum": 1
        },
        "cfg_scale": {
          "type": "number",
          "minimum": 0
        },
        "quality": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "response_handling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transport",
        "image_data_field",
        "decode_required",
        "output_extensions"
      ],
      "properties": {
        "transport": {
          "type": "string",
          "const": "json"
        },
        "image_data_field": {
          "type": "string",
          "minLength": 1
        },
        "decode_required": {
          "type": "boolean",
          "const": true
        },
        "output_extensions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "png",
              "jpg"
            ]
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "mime_type",
          "role"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "mime_type": {
            "type": "string",
            "enum": [
              "image/png",
              "image/jpeg"
            ]
          },
          "role": {
            "type": "string",
            "enum": [
              "primary"
            ]
          }
        }
      }
    }
  }
}
