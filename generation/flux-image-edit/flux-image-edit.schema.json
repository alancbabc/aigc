{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FLUX Image Edit Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "skill",
    "request",
    "response_handling",
    "artifacts"
  ],
  "properties": {
    "skill": {
      "const": "flux-image-edit"
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prompt",
        "model",
        "size",
        "images"
      ],
      "properties": {
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "const": "FLUX.2-klein-9B"
        },
        "size": {
          "type": "string",
          "pattern": "^[0-9]+x[0-9]+$"
        },
        "task_types": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "id",
              "style"
            ]
          }
        },
        "images": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "slot",
              "file_path",
              "purpose"
            ],
            "properties": {
              "slot": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3
              },
              "file_path": {
                "type": "string",
                "minLength": 1
              },
              "purpose": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "num_inference_steps": {
          "type": "integer",
          "minimum": 1
        },
        "guidance_scale": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "response_handling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transport",
        "image_data_field",
        "decode_required",
        "output_extensions"
      ],
      "properties": {
        "transport": {
          "type": "string",
          "const": "json"
        },
        "image_data_field": {
          "type": "string",
          "minLength": 1
        },
        "decode_required": {
          "type": "boolean",
          "const": true
        },
        "output_extensions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "png",
              "jpg"
            ]
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "mime_type",
          "role"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "mime_type": {
            "type": "string",
            "enum": [
              "image/png",
              "image/jpeg"
            ]
          },
          "role": {
            "type": "string",
            "enum": [
              "primary"
            ]
          }
        }
      }
    }
  }
}
