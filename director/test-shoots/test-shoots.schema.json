{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TestShootsStage1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "stage",
    "project_title",
    "scene_no",
    "shots"
  ],
  "properties": {
    "stage": {
      "type": "integer"
    },
    "project_title": {
      "type": "string"
    },
    "style": {
      "type": "string"
    },
    "scene_no": {
      "type": "integer"
    },
    "scene_summary": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "time_of_day": {
      "type": "string"
    },
    "shots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "sound_cues": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "transition_to_next": {
            "type": "string"
          },
          "frame_plan": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "frame_count",
              "frames"
            ],
            "properties": {
              "frame_count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3
              },
              "frames": {
                "type": "array",
                "minItems": 1,
                "maxItems": 3,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type",
                    "intent",
                    "change_focus"
                  ],
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "first",
                        "intermediate",
                        "last"
                      ]
                    },
                    "intent": {
                      "type": "string",
                      "minLength": 1
                    },
                    "change_focus": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          },
          "transition_context": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "visual_bridge",
              "prompt_hint",
              "frame_requirement"
            ],
            "properties": {
              "visual_bridge": {
                "type": "string",
                "minLength": 1
              },
              "prompt_hint": {
                "type": "string",
                "minLength": 1
              },
              "frame_requirement": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "needs_extra_frames",
                  "recommended_frames"
                ],
                "properties": {
                  "needs_extra_frames": {
                    "type": "boolean"
                  },
                  "recommended_frames": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "first",
                        "intermediate",
                        "last"
                      ]
                    },
                    "uniqueItems": true
                  }
                }
              }
            }
          }
        }
      }
    },
    "logic_check": {
      "type": "object"
    }
  }
}
