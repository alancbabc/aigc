{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scene Design",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_title",
    "style",
    "scenes"
  ],
  "properties": {
    "project_title": {
      "type": "string",
      "minLength": 1
    },
    "style": {
      "type": "string",
      "minLength": 1
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scene_no",
          "scene_base",
          "reference_images"
        ],
        "properties": {
          "scene_no": {
            "type": "integer",
            "minimum": 1
          },
          "scene_base": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "location",
              "environment_summary",
              "lighting",
              "anchor_elements",
              "atmosphere"
            ],
            "properties": {
              "location": {
                "type": "string",
                "minLength": 1
              },
              "environment_summary": {
                "type": "string",
                "minLength": 1
              },
              "lighting": {
                "type": "string",
                "minLength": 1
              },
              "anchor_elements": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "atmosphere": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "reference_images": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ref_num",
                "view_type",
                "purpose",
                "prompt",
                "image_path"
              ],
              "properties": {
                "ref_num": {
                  "type": "integer",
                  "minimum": 1
                },
                "view_type": {
                  "type": "string",
                  "enum": [
                    "establishing",
                    "medium_environment",
                    "close_detail",
                    "reverse_angle",
                    "entrance_view"
                  ]
                },
                "purpose": {
                  "type": "string",
                  "minLength": 1
                },
                "prompt": {
                  "type": "string",
                  "minLength": 1
                },
                "image_path": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
