{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Keyframe Images",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "stage",
    "project_title",
    "scene_no",
    "shots"
  ],
  "properties": {
    "stage": {
      "type": "integer",
      "const": 3
    },
    "project_title": {
      "type": "string",
      "minLength": 1
    },
    "scene_no": {
      "type": "integer",
      "minimum": 1
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "shot_no",
          "frames"
        ],
        "properties": {
          "shot_no": {
            "type": "integer",
            "minimum": 1
          },
          "frames": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "intent",
                "change_focus",
                "prompt",
                "output_image",
                "status"
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "enum": ["first", "intermediate", "last"]
                },
                "intent": {
                  "type": "string",
                  "minLength": 1
                },
                "change_focus": {
                  "type": "string",
                  "minLength": 1
                },
                "prompt": {
                  "type": "string",
                  "minLength": 1
                },
                "output_image": {
                  "type": "string",
                  "minLength": 1
                },
                "status": {
                  "type": "string",
                  "enum": ["confirmed", "needs_regen"]
                }
              }
            }
          }
        }
      }
    }
  }
}
