{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Keyframe Prompts",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "stage",
    "project_title",
    "scene_no",
    "shots"
  ],
  "properties": {
    "stage": {
      "type": "integer",
      "const": 2
    },
    "project_title": {
      "type": "string",
      "minLength": 1
    },
    "style": {
      "type": "string"
    },
    "scene_no": {
      "type": "integer",
      "minimum": 1
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "shot_no",
          "reference_images",
          "frame_config"
        ],
        "properties": {
          "shot_no": {
            "type": "integer",
            "minimum": 1
          },
          "reference_images": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "characters",
              "scene"
            ],
            "properties": {
              "characters": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "scene": {
                "type": "string"
              }
            }
          },
          "frame_config": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "frames"
            ],
            "properties": {
              "frames": {
                "type": "array",
                "minItems": 1,
                "maxItems": 3,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type",
                    "intent",
                    "change_focus",
                    "prompt"
                  ],
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": ["first", "intermediate", "last"]
                    },
                    "intent": {
                      "type": "string",
                      "minLength": 1
                    },
                    "change_focus": {
                      "type": "string",
                      "minLength": 1
                    },
                    "prompt": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
