{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FilmProductionVideoPromptDrafts",
  "description": "Raw per-shot or per-scene video prompt drafts prepared before LTX prompt optimization.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_title", "keyframe_images_ref", "entries"],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "project_title": {
      "type": "string",
      "minLength": 1
    },
    "style": {
      "type": "string"
    },
    "keyframe_images_ref": {
      "type": "string",
      "minLength": 1
    },
    "keyframe_prompts_ref": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "prompt_id",
          "scene_no",
          "shot_no",
          "clip_type",
          "render_mode",
          "source_image_paths",
          "prompt_draft"
        ],
        "properties": {
          "prompt_id": {
            "type": "string",
            "minLength": 1
          },
          "scene_no": {
            "type": "integer",
            "minimum": 1
          },
          "shot_no": {
            "type": "integer",
            "minimum": 1
          },
          "scene_id": {
            "type": "string"
          },
          "shot_id": {
            "type": "string"
          },
          "clip_type": {
            "type": "string",
            "enum": ["shot", "transition"]
          },
          "render_mode": {
            "type": "string",
            "enum": ["audio_to_video", "text_image_to_video_high_quality"]
          },
          "transition_type": {
            "type": "string"
          },
          "from_shot_id": {
            "type": "string"
          },
          "to_shot_id": {
            "type": "string"
          },
          "from_last_frame": {
            "type": "string"
          },
          "to_first_frame": {
            "type": "string"
          },
          "visual_bridge": {
            "type": "string"
          },
          "bridge_logic": {
            "type": "string"
          },
          "source_image_paths": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "source_audio_path": {
            "type": "string"
          },
          "prompt_basis": {
            "type": "string",
            "description": "Short note on what upstream decision or keyframe intent the raw prompt is based on."
          },
          "prompt_draft": {
            "type": "string",
            "minLength": 1,
            "description": "Original video prompt before LTX-specific optimization."
          },
          "target_duration_seconds": {
            "type": "number",
            "minimum": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "clip_type": { "const": "transition" }
            }
          },
          "then": {
            "required": [
              "transition_type",
              "from_last_frame",
              "to_first_frame",
              "visual_bridge",
              "bridge_logic"
            ]
          }
        }
      }
    }
  }
}
