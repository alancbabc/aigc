{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/contracts/mv-keyframe-director.schema.json",
  "title": "MV director keyframe + I2V prompt plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "song_title",
    "source_refs",
    "keyframes"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "song_title": {
      "type": "string",
      "minLength": 1
    },
    "artist": { "type": "string" },
    "director_notes_zh": { "type": "string" },
    "source_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lyrics_timing_ref",
        "song_sections_llm_ref",
        "mv_global_visual_style_ref"
      ],
      "properties": {
        "lyrics_timing_ref": { "type": "string", "minLength": 1 },
        "song_sections_llm_ref": { "type": "string", "minLength": 1 },
        "mv_global_visual_style_ref": { "type": "string", "minLength": 1 }
      }
    },
    "keyframes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "keyframe_id",
          "primary_section_ref",
          "section_type_focus",
          "line_refs",
          "start_time",
          "end_time",
          "lines",
          "keyframe_type",
          "narrative_beat_zh",
          "keyframe_image_prompt_en",
          "video_from_keyframe_prompt_en"
        ],
        "properties": {
          "keyframe_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "description": "Stable id, snake_case, e.g. kf_01"
          },
          "primary_section_ref": {
            "type": "string",
            "minLength": 1,
            "description": "Dominant song-section id from song-sections-llm"
          },
          "section_type_focus": {
            "type": "string",
            "description": "verse | chorus | bridge | … for style cohesion"
          },
          "line_refs": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 4 }
          },
          "start_time": { "type": "number" },
          "end_time": { "type": "number" },
          "lines": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["line_id", "text", "start_time"],
              "properties": {
                "line_id": { "type": "string" },
                "text": { "type": "string" },
                "start_time": { "type": "number" },
                "end_time": { "type": ["number", "null"] },
                "duration_seconds": { "type": ["number", "null"] }
              }
            }
          },
          "narrative_beat_zh": {
            "type": "string",
            "description": "Why this keyframe exists in the MV story rhythm"
          },
          "continuity_previous_en": { "type": "string" },
          "continuity_next_en": { "type": "string" },
          "keyframe_type": {
            "type": "string",
            "enum": ["lyric_visual", "lyric_emotional", "lyric_philosophical", "character_singing", "instrumental", "lyric_imagery"],
            "description": "lyric_visual: lyrics have concrete visual entities → t2i. lyric_emotional: abstract but intense → translate emotion temp to visual metaphor → t2i. lyric_philosophical: deep conceptual meaning → symbolic imagery → t2i. character_singing: no visual anchor at all → i2i with ref images. instrumental: pure music passage → abstract texture or wide empty shot. lyric_imagery: legacy alias for lyric_visual."
          },
          "keyframe_image_prompt_en": {
            "type": "string",
            "minLength": 24,
            "description": "English still-image prompt (16:9 keyframe)."
          },
          "video_from_keyframe_prompt_en": {
            "type": "string",
            "minLength": 24,
            "description": "English image-to-video motion/camera/action prompt anchored on the keyframe."
          }
        }
      }
    },
    "instrumental_bookends": {
      "type": "array",
      "description": "Optional segments without lyric line_refs (e.g. intro before first LRC line, outro tail). Fills instrumental timeline gaps; not part of the lyric-line partition.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "keyframe_id",
          "role",
          "primary_section_ref",
          "section_type_focus",
          "start_time",
          "end_time",
          "keyframe_type",
          "keyframe_image_prompt_en",
          "video_from_keyframe_prompt_en"
        ],
        "properties": {
          "keyframe_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "description": "e.g. inst_intro, inst_outro"
          },
          "role": {
            "type": "string",
            "enum": ["intro", "outro", "instrumental"]
          },
          "primary_section_ref": {
            "type": "string",
            "minLength": 1,
            "description": "Nearest song-section id (e.g. verse_1 for intro, outro for tail)"
          },
          "section_type_focus": {
            "type": "string",
            "minLength": 1,
            "description": "Typically instrumental; may mirror verse/chorus mood"
          },
          "start_time": { "type": "number" },
          "end_time": { "type": "number" },
          "narrative_beat_zh": { "type": "string" },
          "continuity_previous_en": { "type": "string" },
          "continuity_next_en": { "type": "string" },
          "keyframe_type": {
            "type": "string",
            "enum": ["lyric_imagery", "character_singing"],
            "description": "Instrumental bookends default to lyric_imagery."
          },
          "keyframe_image_prompt_en": {
            "type": "string",
            "minLength": 24,
            "description": "English still-image prompt (16:9 keyframe)."
          },
          "video_from_keyframe_prompt_en": {
            "type": "string",
            "minLength": 24,
            "description": "English image-to-video motion/camera prompt for this segment."
          }
        }
      }
    }
  }
}
