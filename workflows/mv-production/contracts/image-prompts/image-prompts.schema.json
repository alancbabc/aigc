{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MVImagePrompts",
  "description": "Image generation prompts derived from shot-plan. Each shot gets a stable, unified prompt for static keyframe generation. Ambient hold shots reuse previous images.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_shot_plan_ref", "project_info", "global_style", "image_prompts"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "song_title": { "type": "string", "minLength": 1 },
    "artist": { "type": "string" },
    "source_shot_plan_ref": { "type": "string", "minLength": 1 },
    "project_info": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mv_type", "visual_mode", "aspect_ratio"],
      "properties": {
        "mv_type": { "type": "string", "const": "imagery_based_music_video" },
        "visual_mode": { "type": "string", "const": "poetic_symbolic" },
        "aspect_ratio": { "type": "string", "const": "16:9" }
      }
    },
    "global_style": {
      "type": "object",
      "additionalProperties": false,
      "required": ["style_name", "global_prompt_prefix", "global_negative_prompt", "color_system", "lighting_system", "texture_system"],
      "properties": {
        "style_name": { "type": "string", "minLength": 1 },
        "global_prompt_prefix": { "type": "string", "minLength": 20 },
        "global_negative_prompt": { "type": "string", "minLength": 20 },
        "color_system": { "type": "array", "minItems": 3, "items": { "type": "string" } },
        "lighting_system": { "type": "string", "minLength": 1 },
        "texture_system": { "type": "string", "minLength": 1 }
      }
    },
    "image_prompts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "prompt_id", "shot_id", "parent_segment_id", "parent_section_id",
          "time_range", "render_strategy", "prompt_language",
          "image_prompt", "negative_prompt", "prompt_components",
          "generation_parameters", "quality_check"
        ],
        "properties": {
          "prompt_id": { "type": "string", "minLength": 1 },
          "shot_id": { "type": "string", "minLength": 1 },
          "parent_segment_id": { "type": "string", "minLength": 1 },
          "parent_section_id": { "type": "string", "minLength": 1 },
          "time_range": {
            "type": "object",
            "additionalProperties": false,
            "required": ["start_time", "end_time", "duration_seconds"],
            "properties": {
              "start_time": { "type": "number", "minimum": 0 },
              "end_time": { "type": "number", "minimum": 0 },
              "duration_seconds": { "type": "number", "minimum": 0 }
            }
          },
          "render_strategy": {
            "type": "object",
            "additionalProperties": false,
            "required": ["generate_new_image"],
            "properties": {
              "generate_new_image": { "type": "boolean" },
              "reuse_from_shot_id": { "type": ["string", "null"] }
            }
          },
          "prompt_language": { "type": "string", "const": "en" },
          "image_prompt": {
            "type": ["string", "null"],
            "description": "Full English prompt for the image generation model. Null only for ambient_hold shots."
          },
          "negative_prompt": {
            "type": ["string", "null"]
          },
          "prompt_components": {
            "type": "object",
            "additionalProperties": false,
            "required": ["main_subject", "environment", "composition", "lighting", "emotion", "style_keywords"],
            "properties": {
              "main_subject": { "type": ["string", "null"] },
              "environment": { "type": ["string", "null"] },
              "composition": { "type": ["string", "null"] },
              "lighting": { "type": ["string", "null"] },
              "emotion": { "type": ["string", "null"] },
              "style_keywords": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          },
          "generation_parameters": {
            "type": "object",
            "additionalProperties": false,
            "required": ["aspect_ratio", "resolution"],
            "properties": {
              "aspect_ratio": { "type": "string" },
              "resolution": { "type": "string" },
              "seed": { "type": ["integer", "null"] },
              "num_candidates": { "type": "integer", "minimum": 1 }
            }
          },
          "quality_check": {
            "type": "object",
            "additionalProperties": false,
            "required": ["must_include", "must_avoid", "continuity_tags"],
            "properties": {
              "must_include": { "type": "array", "items": { "type": "string" } },
              "must_avoid": { "type": "array", "items": { "type": "string" } },
              "continuity_tags": { "type": "array", "items": { "type": "string" } }
            }
          },
          "generation_notes": { "type": "string" }
        }
      }
    }
  }
}
