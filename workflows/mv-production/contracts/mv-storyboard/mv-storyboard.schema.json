{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MVProductionStoryboard",
  "description": "Beat-synced MV storyboard extending the standard storyboard contract with song timeline alignment, lyrics references, and performance type annotations.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "song_title", "song_structure_ref", "mv_treatment_ref", "scenes"],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "song_title": {
      "type": "string",
      "minLength": 1
    },
    "song_structure_ref": {
      "type": "string",
      "minLength": 1
    },
    "mv_treatment_ref": {
      "type": "string",
      "minLength": 1
    },
    "characters_ref": {
      "type": "string"
    },
    "total_shots": {
      "type": "integer",
      "minimum": 1
    },
    "average_shot_duration_seconds": {
      "type": "number"
    },
    "cutting_rhythm_notes": {
      "type": "string",
      "description": "Overall notes on how cutting pace relates to musical rhythm."
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scene_id", "section_ref", "shots"],
        "properties": {
          "scene_id": {
            "type": "string",
            "minLength": 1
          },
          "section_ref": {
            "type": "string",
            "minLength": 1,
            "description": "References section_id in song-structure.json."
          },
          "scene_description": {
            "type": "string"
          },
          "visual_world": {
            "type": "string"
          },
          "shots": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["shot_id", "shot_type", "time_window", "camera"],
              "properties": {
                "shot_id": {
                  "type": "string",
                  "minLength": 1
                },
                "shot_type": {
                  "type": "string",
                  "enum": ["establishing", "wide", "medium", "close_up", "extreme_close_up", "over_shoulder", "pov", "aerial", "tracking", "insert"]
                },
                "performance_type": {
                  "type": "string",
                  "enum": ["lip_sync", "dance", "instrument", "reaction", "b_roll", "narrative_action", "concept_imagery"],
                  "description": "What kind of content this shot captures."
                },
                "time_window": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["start_time", "end_time"],
                  "properties": {
                    "start_time": {
                      "type": "number",
                      "minimum": 0
                    },
                    "end_time": {
                      "type": "number",
                      "minimum": 0
                    },
                    "duration_seconds": {
                      "type": "number",
                      "minimum": 0
                    }
                  }
                },
                "beat_sync": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "start_beat": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "end_beat": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "cut_on_beat": {
                      "type": "boolean",
                      "description": "Whether this shot's entry cut aligns with a musical beat."
                    },
                    "beat_emphasis": {
                      "type": "string",
                      "enum": ["downbeat", "upbeat", "offbeat", "none"],
                      "description": "Which beat position the cut targets."
                    }
                  }
                },
                "lyrics_line_refs": {
                  "type": "array",
                  "items": { "type": "string" },
                  "description": "Which lyrics lines are sung during this shot."
                },
                "camera": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["shot_size"],
                  "properties": {
                    "shot_size": {
                      "type": "string"
                    },
                    "angle": {
                      "type": "string"
                    },
                    "movement": {
                      "type": "string"
                    },
                    "lens": {
                      "type": "string"
                    }
                  }
                },
                "character_refs": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "action_description": {
                  "type": "string",
                  "description": "What happens visually in this shot."
                },
                "emotion": {
                  "type": "string"
                },
                "lighting": {
                  "type": "string"
                },
                "transition_in": {
                  "type": "string",
                  "description": "How this shot begins (cut, dissolve, wipe, etc.)."
                },
                "transition_out": {
                  "type": "string"
                },
                "render_mode_hint": {
                  "type": "string",
                  "enum": ["audio_to_video", "text_image_to_video_high_quality", "image_audio_ffmpeg"],
                  "description": "Suggested render mode for downstream video generation."
                },
                "notes": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
