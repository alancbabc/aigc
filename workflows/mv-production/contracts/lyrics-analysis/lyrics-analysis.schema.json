{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MVProductionLyricsAnalysis",
  "description": "Lyrics imagery and emotion analysis for MV production workflow. Extracts visual potential, themes, and performance cues from song lyrics.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "song_title", "song_structure_ref", "themes", "emotion_arc", "sections"],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "song_title": {
      "type": "string",
      "minLength": 1
    },
    "artist": {
      "type": "string"
    },
    "song_structure_ref": {
      "type": "string",
      "minLength": 1,
      "description": "Reference to the song-structure.json this analysis is based on."
    },
    "language": {
      "type": "string",
      "description": "Primary language of the lyrics."
    },
    "themes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["theme", "weight"],
        "properties": {
          "theme": {
            "type": "string",
            "minLength": 1
          },
          "weight": {
            "type": "string",
            "enum": ["primary", "secondary", "minor"]
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "emotion_arc": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["section_ref", "dominant_emotion", "intensity"],
        "properties": {
          "section_ref": {
            "type": "string",
            "minLength": 1
          },
          "dominant_emotion": {
            "type": "string"
          },
          "secondary_emotion": {
            "type": "string"
          },
          "intensity": {
            "type": "string",
            "enum": ["subtle", "moderate", "strong", "overwhelming"]
          }
        }
      }
    },
    "narrative_potential": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "recommended_mv_type"],
      "properties": {
        "score": {
          "type": "string",
          "enum": ["high", "medium", "low"],
          "description": "How well the lyrics support a narrative-driven MV."
        },
        "recommended_mv_type": {
          "type": "string",
          "enum": ["narrative", "performance", "concept", "mixed"]
        },
        "reasoning": {
          "type": "string"
        }
      }
    },
    "visual_metaphors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["metaphor", "visual_translation"],
        "properties": {
          "metaphor": {
            "type": "string",
            "description": "The lyrical metaphor or imagery."
          },
          "source_lines": {
            "type": "array",
            "items": { "type": "string" }
          },
          "visual_translation": {
            "type": "string",
            "description": "How this metaphor could be rendered visually."
          },
          "recurrence": {
            "type": "string",
            "enum": ["once", "recurring", "throughout"],
            "description": "How often this imagery appears in the lyrics."
          }
        }
      }
    },
    "color_mood_suggestions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["section_ref", "palette"],
        "properties": {
          "section_ref": {
            "type": "string"
          },
          "palette": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Suggested color keywords for this section."
          },
          "lighting": {
            "type": "string"
          }
        }
      }
    },
    "performance_cues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["section_ref", "cue_type", "description"],
        "properties": {
          "section_ref": {
            "type": "string"
          },
          "cue_type": {
            "type": "string",
            "enum": ["facial_expression", "body_language", "gesture", "movement", "interaction", "stillness"]
          },
          "description": {
            "type": "string"
          },
          "intensity": {
            "type": "string",
            "enum": ["subtle", "moderate", "strong"]
          }
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["section_ref", "imagery"],
        "properties": {
          "section_ref": {
            "type": "string",
            "minLength": 1,
            "description": "References section_id in song-structure.json."
          },
          "lyrics_text": {
            "type": "string",
            "description": "Full lyrics text for this section."
          },
          "imagery": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" },
            "description": "Core visual images extractable from this section's lyrics."
          },
          "key_lines": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["line_id", "text"],
              "properties": {
                "line_id": { "type": "string" },
                "text": { "type": "string" },
                "visual_potential": { "type": "string" },
                "performance_note": { "type": "string" }
              }
            }
          },
          "section_visual_summary": {
            "type": "string",
            "description": "One-paragraph summary of the visual world this section's lyrics suggest."
          }
        }
      }
    },
    "analysis_notes": {
      "type": "string"
    }
  }
}
