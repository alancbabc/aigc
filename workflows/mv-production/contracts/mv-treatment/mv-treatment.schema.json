{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MVProductionTreatment",
  "description": "MV creative treatment for mv-production workflow. Defines the overall concept, visual style, and per-section visual plan.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "song_title", "song_structure_ref", "concept_type", "visual_style", "section_plans"],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "song_title": {
      "type": "string",
      "minLength": 1
    },
    "artist": {
      "type": "string"
    },
    "song_structure_ref": {
      "type": "string",
      "minLength": 1
    },
    "concept_type": {
      "type": "string",
      "enum": ["narrative", "performance", "concept", "mixed"]
    },
    "concept_summary": {
      "type": "string",
      "description": "One-paragraph elevator pitch for the MV concept."
    },
    "visual_style": {
      "type": "object",
      "additionalProperties": false,
      "required": ["style_keywords"],
      "properties": {
        "style_keywords": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "description": "English style tokens aligned with _prompts/PromptTemplates/Style/."
        },
        "reference_directors": {
          "type": "array",
          "items": { "type": "string" }
        },
        "reference_mvs": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Reference MV titles or links for visual inspiration."
        },
        "aspect_ratio": {
          "type": "string",
          "description": "Target aspect ratio, e.g. 16:9, 9:16, 2.35:1."
        },
        "grain_texture": {
          "type": "string",
          "enum": ["none", "subtle_film", "heavy_film", "digital_clean", "vintage"]
        }
      }
    },
    "color_palette": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dominant_colors": {
          "type": "array",
          "items": { "type": "string" }
        },
        "accent_colors": {
          "type": "array",
          "items": { "type": "string" }
        },
        "color_shift_strategy": {
          "type": "string",
          "description": "How color changes across the MV, e.g. cool-to-warm progression."
        }
      }
    },
    "narrative_thread": {
      "type": "object",
      "additionalProperties": false,
      "description": "Present when concept_type is narrative or mixed.",
      "properties": {
        "premise": {
          "type": "string"
        },
        "protagonist": {
          "type": "string"
        },
        "conflict": {
          "type": "string"
        },
        "resolution": {
          "type": "string"
        },
        "timeline_structure": {
          "type": "string",
          "enum": ["linear", "non_linear", "parallel", "reverse", "circular"],
          "description": "How the story maps to the song timeline."
        }
      }
    },
    "performance_plan": {
      "type": "object",
      "additionalProperties": false,
      "description": "Present when concept_type is performance or mixed.",
      "properties": {
        "performance_style": {
          "type": "string",
          "enum": ["lip_sync", "dance", "instrument", "static_pose", "mixed"]
        },
        "stage_description": {
          "type": "string"
        },
        "choreography_notes": {
          "type": "string"
        },
        "camera_strategy": {
          "type": "string",
          "description": "Overall camera approach for performance shots."
        }
      }
    },
    "cross_cutting_rules": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Rules for interleaving narrative, performance, and concept footage."
    },
    "section_plans": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["section_ref", "visual_world", "primary_content_type"],
        "properties": {
          "section_ref": {
            "type": "string",
            "minLength": 1
          },
          "visual_world": {
            "type": "string",
            "description": "The visual environment or world for this section."
          },
          "primary_content_type": {
            "type": "string",
            "enum": ["narrative", "performance", "concept_imagery", "mixed"]
          },
          "scene_refs": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Scene IDs from scene_design.json used in this section."
          },
          "character_refs": {
            "type": "array",
            "items": { "type": "string" }
          },
          "key_visual_moments": {
            "type": "array",
            "items": { "type": "string" },
            "description": "The most important visual beats in this section."
          },
          "camera_approach": {
            "type": "string"
          },
          "transition_strategy": {
            "type": "string",
            "description": "How this section transitions to the next."
          },
          "energy_match": {
            "type": "string",
            "description": "How the visual energy matches the musical energy."
          }
        }
      }
    },
    "treatment_notes": {
      "type": "string"
    }
  }
}
