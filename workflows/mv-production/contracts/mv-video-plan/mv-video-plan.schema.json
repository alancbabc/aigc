{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MVProductionVideoPlan",
  "description": "Timeline-aware video generation plan for MV production. Each entry maps to a song time window and carries render parameters for LTX or FFmpeg execution.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "song_title", "song_file_path", "video_prompt_drafts_ref", "video_ltx_prompts_ref", "total_duration_seconds", "entries"],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "song_title": {
      "type": "string",
      "minLength": 1
    },
    "song_file_path": {
      "type": "string",
      "minLength": 1,
      "description": "Path to the original song audio file used for final assembly."
    },
    "video_prompt_drafts_ref": {
      "type": "string",
      "minLength": 1
    },
    "video_ltx_prompts_ref": {
      "type": "string",
      "minLength": 1
    },
    "total_duration_seconds": {
      "type": "number",
      "minimum": 1
    },
    "output_dimensions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "assembly_notes": {
      "type": "string",
      "description": "Notes for the final assembly stage about audio overlay and transition handling."
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entry_id", "shot_ref", "section_ref", "time_window", "render_mode", "prompt_ref"],
        "properties": {
          "entry_id": {
            "type": "string",
            "minLength": 1
          },
          "shot_ref": {
            "type": "string",
            "minLength": 1,
            "description": "References shot_id in the MV storyboard."
          },
          "section_ref": {
            "type": "string",
            "minLength": 1,
            "description": "References section_id in song-structure.json."
          },
          "scene_id": {
            "type": "string"
          },
          "time_window": {
            "type": "object",
            "additionalProperties": false,
            "required": ["start_time", "end_time", "duration_seconds"],
            "properties": {
              "start_time": {
                "type": "number",
                "minimum": 0,
                "description": "Start time in the song timeline in seconds."
              },
              "end_time": {
                "type": "number",
                "minimum": 0
              },
              "duration_seconds": {
                "type": "number",
                "minimum": 0
              }
            }
          },
          "render_mode": {
            "type": "string",
            "enum": ["audio_to_video", "text_image_to_video_high_quality", "image_audio_ffmpeg"]
          },
          "prompt_ref": {
            "type": "string",
            "minLength": 1,
            "description": "References prompt_id in video-ltx-prompts.json or video-prompt-drafts.json."
          },
          "source_image_paths": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1,
            "description": "Keyframe images used as reference for video generation."
          },
          "audio_segment_path": {
            "type": "string",
            "description": "Path to the extracted audio segment for this time window. Used by audio_to_video mode."
          },
          "output_path": {
            "type": "string",
            "description": "Target output path for the generated video segment."
          },
          "ltx_request": {
            "type": "object",
            "description": "LTX-specific request parameters when render_mode is audio_to_video or text_image_to_video_high_quality.",
            "properties": {
              "mode": { "type": "string" },
              "audio": { "type": "string" },
              "images": {
                "type": "array",
                "items": { "type": "string" }
              },
              "save_path": { "type": "string" },
              "duration_seconds": { "type": "number" },
              "negative_prompt": { "type": "string" }
            }
          },
          "ffmpeg_request": {
            "type": "object",
            "description": "FFmpeg-specific parameters when render_mode is image_audio_ffmpeg.",
            "properties": {
              "image_path": { "type": "string" },
              "audio_path": { "type": "string" },
              "save_path": { "type": "string" },
              "motion_style": {
                "type": "string",
                "enum": ["static", "ken_burns", "slow_zoom", "slow_pan"]
              },
              "target_width": { "type": "integer" },
              "target_height": { "type": "integer" }
            }
          },
          "transition_in": {
            "type": "string"
          },
          "transition_out": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}
