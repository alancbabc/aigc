{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MVSegmentInterpretation",
  "description": "Semantic interpretation of each visual segment from song-sections-llm. Upgrades segments from lyric-time blocks to generation-ready semantic blocks. Instrumental-only segments get placeholder entries.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "song_title", "source_sections_llm_ref", "segments"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "song_title": { "type": "string", "minLength": 1 },
    "artist": { "type": "string" },
    "source_sections_llm_ref": { "type": "string", "minLength": 1 },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["segment_id", "parent_section_id", "section_type", "is_instrumental", "time_range", "lyrics"],
        "properties": {
          "segment_id": { "type": "string", "minLength": 1 },
          "parent_section_id": { "type": "string", "minLength": 1 },
          "section_type": { "type": "string" },
          "is_instrumental": {
            "type": "boolean",
            "description": "True when ALL line_refs in this segment are is_instrumental=true. These segments have placeholder interpretation fields; their visuals should extend the preceding segment's imagery."
          },
          "time_range": {
            "type": "object",
            "additionalProperties": false,
            "required": ["start_time", "end_time", "duration_seconds"],
            "properties": {
              "start_time": { "type": "number", "minimum": 0 },
              "end_time": { "type": "number", "minimum": 0 },
              "duration_seconds": { "type": "number", "minimum": 0 }
            }
          },
          "lyrics": {
            "type": "object",
            "additionalProperties": false,
            "required": ["line_refs", "lyrics_text"],
            "properties": {
              "line_refs": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string" }
              },
              "lyrics_text": { "type": "string" }
            }
          },
          "interpretation": {
            "type": "object",
            "additionalProperties": false,
            "description": "Core semantic layer. For instrumental segments, all fields are placeholder values.",
            "required": ["literal_meaning_zh", "deep_meaning_zh", "emotional_state_zh", "emotional_intensity"],
            "properties": {
              "literal_meaning_zh": { "type": "string", "minLength": 1 },
              "deep_meaning_zh": { "type": "string", "minLength": 1 },
              "emotional_state_zh": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string" }
              },
              "emotional_intensity": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
            }
          },
          "imagery": {
            "type": "array",
            "description": "Visual imagery extracted from this segment's lyrics. Material library for downstream prompts. Instrumental segments have empty array.",
            "minItems": 0,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["image_zh", "image_en", "type", "visual_priority", "symbolic_meaning_zh"],
              "properties": {
                "image_zh": { "type": "string", "minLength": 1 },
                "image_en": { "type": "string", "minLength": 1 },
                "type": {
                  "type": "string",
                  "enum": ["natural", "atmosphere", "symbolic_creature", "character", "object", "action"]
                },
                "visual_priority": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
                "symbolic_meaning_zh": { "type": "string", "minLength": 1 }
              }
            }
          },
          "visual_direction": {
            "type": "object",
            "additionalProperties": false,
            "description": "Visual style constraints for this specific segment. For instrumental segments, indicates that visuals extend preceding segment's style.",
            "required": ["scene_type", "setting_zh", "color_palette", "lighting", "composition_zh", "camera_mood"],
            "properties": {
              "scene_type": { "type": "string" },
              "setting_zh": { "type": "string", "minLength": 1 },
              "color_palette": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string" }
              },
              "lighting": { "type": "string", "minLength": 1 },
              "composition_zh": { "type": "string", "minLength": 1 },
              "camera_mood": { "type": "string", "minLength": 1 }
            }
          },
          "shot_planning_hint": {
            "type": "object",
            "additionalProperties": false,
            "description": "Hints for the future shot-plan stage. Instrumental segments use keyframe_count=0 to skip generation.",
            "required": ["recommended_shot_count", "keyframe_count", "motion_intensity", "transition_in", "transition_out"],
            "properties": {
              "recommended_shot_count": { "type": "integer", "minimum": 0 },
              "keyframe_count": { "type": "integer", "minimum": 0 },
              "motion_intensity": { "type": "string", "enum": ["none", "low", "medium", "high"] },
              "transition_in": { "type": "string" },
              "transition_out": { "type": "string" },
              "variation_from": { "type": ["string", "null"] },
              "variation_strategy": { "type": ["string", "null"] }
            }
          },
          "generation_constraints": {
            "type": "object",
            "additionalProperties": false,
            "description": "What must be in the frame and what must be avoided. For instrumental segments, empty constraints.",
            "required": ["must_include", "avoid"],
            "properties": {
              "must_include": {
                "type": "array",
                "items": { "type": "string" }
              },
              "avoid": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
