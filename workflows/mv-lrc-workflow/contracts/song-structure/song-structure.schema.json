{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MVLRCWorkflowSongStructure",
  "description": "Song structure analysis for MV-LRC-Workflow. Parses LRC format to extract timed sections with mood, energy, and visual metadata.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "song_title", "total_duration_seconds", "sections"],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "song_title": {
      "type": "string",
      "minLength": 1
    },
    "artist": {
      "type": "string"
    },
    "total_duration_seconds": {
      "type": "number",
      "minimum": 1
    },
    "bpm": {
      "type": "number",
      "minimum": 1,
      "description": "Beats per minute. May be estimated manually or detected by audio analysis."
    },
    "time_signature": {
      "type": "string",
      "description": "Time signature such as 4/4 or 3/4."
    },
    "key": {
      "type": "string",
      "description": "Musical key if known, e.g. C minor, A major."
    },
    "mood_arc": {
      "type": "array",
      "items": { "type": "string" },
      "description": "High-level mood progression across the entire song."
    },
    "energy_arc": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["low", "medium_low", "medium", "medium_high", "high", "peak"]
      },
      "description": "Energy progression across the song, one entry per section."
    },
    "analysis_method": {
      "type": "string",
      "enum": ["lrc_parse", "lyrics_pattern", "manual", "audio_analysis"],
      "description": "How the song structure was determined. For this workflow, defaults to lrc_parse."
    },
    "lrc_source": {
      "type": "string",
      "description": "Source LRC file path."
    },
    "analysis_notes": {
      "type": "string"
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["section_id", "section_type", "start_time", "end_time", "duration_seconds"],
        "properties": {
          "section_id": {
            "type": "string",
            "minLength": 1
          },
          "section_type": {
            "type": "string",
            "enum": ["intro", "verse", "pre_chorus", "chorus", "post_chorus", "bridge", "breakdown", "instrumental", "outro", "interlude"],
            "description": "Structural role of this section in the song."
          },
          "section_label": {
            "type": "string",
            "description": "Human-readable label such as Verse 1 or Chorus 2."
          },
          "start_time": {
            "type": "number",
            "minimum": 0
          },
          "end_time": {
            "type": "number",
            "minimum": 0
          },
          "duration_seconds": {
            "type": "number",
            "minimum": 0
          },
          "start_beat": {
            "type": "integer",
            "minimum": 1,
            "description": "Beat number at section start, relative to song start."
          },
          "end_beat": {
            "type": "integer",
            "minimum": 1
          },
          "mood": {
            "type": "string"
          },
          "energy_level": {
            "type": "string",
            "enum": ["low", "medium_low", "medium", "medium_high", "high", "peak"]
          },
          "lyrics_lines": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Lyric lines contained in this section."
          },
          "lyrics_summary": {
            "type": ["string", "null"],
            "description": "Brief summary of the lyrical content in this section. Null for instrumental sections."
          },
          "visual_suggestion": {
            "type": "string",
            "description": "Initial visual direction suggestion for this section."
          },
          "transition_to_next": {
            "type": "string",
            "description": "Suggested transition style into the next section."
          }
        }
      }
    }
  }
}