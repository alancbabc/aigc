{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NewsCommentaryTtsPlan",
  "description": "Pre-TTS split plan for news-commentary workflow",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "title", "max_target_duration_seconds", "entries"],
  "properties": {
    "schema_version": { "type": "string" },
    "title": { "type": "string" },
    "source_script_ref": { "type": "string" },
    "max_target_duration_seconds": { "type": "number", "minimum": 0, "maximum": 15 },
    "estimated_total_duration_seconds": { "type": "number", "minimum": 0 },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entry_id",
          "script_line_id",
          "segment_no",
          "segment_type",
          "line_no",
          "speaker",
          "text",
          "estimated_duration_seconds",
          "split_part_no",
          "split_part_total",
          "source_line_text"
        ],
        "properties": {
          "entry_id": { "type": "string" },
          "script_line_id": { "type": "string" },
          "segment_no": { "type": "integer" },
          "segment_type": {
            "type": "string",
            "enum": ["opening", "headline", "discussion", "summary", "closing"]
          },
          "line_no": { "type": "integer" },
          "speaker": {
            "type": "string",
            "enum": ["host", "guest"]
          },
          "text": { "type": "string" },
          "emotion": { "type": "string" },
          "estimated_duration_seconds": { "type": "number", "minimum": 0, "maximum": 15 },
          "planned_audio_path": { "type": "string" },
          "pause_before": { "type": "number", "minimum": 0 },
          "pause_after": { "type": "number", "minimum": 0 },
          "voice_source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mode"],
            "properties": {
              "mode": {
                "type": "string",
                "enum": ["tts_voice_id", "voice_reference_audio", "mixed"]
              },
              "tts_voice_id": { "type": "string" },
              "voice_reference_audio": { "type": "string" },
              "template_id": { "type": "string" },
              "local_tts_speaker": { "type": "string" },
              "local_tts_language": { "type": "string" },
              "local_tts_instruction": { "type": "string" }
            }
          },
          "split_part_no": { "type": "integer", "minimum": 1 },
          "split_part_total": { "type": "integer", "minimum": 1 },
          "split_group_id": { "type": "string" },
          "source_line_text": { "type": "string" }
        }
      }
    }
  },
  "allOf": [
    {
      "properties": {
        "entries": {
          "items": {
            "if": {
              "properties": {
                "split_part_total": { "minimum": 2 }
              }
            },
            "then": {
              "required": ["split_group_id"]
            }
          }
        }
      }
    }
  ]
}
